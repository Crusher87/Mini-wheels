{
  "name": "mini-wheels-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room browser reconstruction of a compact local-multiplayer physics sandbox.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:matrix": "node scripts/run-browser-tests.mjs --matrix",
    "test:browser:production": "npm run build && node scripts/run-browser-tests.mjs --production",
    "test:visual": "node scripts/run-browser-tests.mjs --native-quality --visual --grep=VIS-",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:browser:production && npm run test:browser"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/three": "0.185.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
